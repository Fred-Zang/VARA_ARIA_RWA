# Identité utilisateur dans le conteneur (adapter à `id -u` / `id -g` si nécessaire).
RWA_UID=1000
RWA_GID=1000

# Providers LLM
OPENAI_API_KEY=replace_with_local_secret
GEMINI_API_KEY=replace_with_local_secret
RWA_DEFAULT_LLM_MODEL=gpt-4.1-2025-04-14

# Backend de démonstration / intégration
RWA_API_KEY=replace_with_backend_secret
RWA_API_BASE_URL=https://example.invalid
RWA_ALLOW_INSECURE_HTTP=false

# Routes génériques de la démonstration publique. Les routes réelles de production
# ne sont pas publiées et peuvent être injectées au runtime si nécessaire.
RWA_API_FRAMEWORK_PATH=/api/v1/framework
RWA_API_PROJECTS_PATH=/api/v1/projects
RWA_API_REPORT_UPDATE_PATH=/api/v1/reports/update
RWA_API_REFERENCE_UPLOAD_PATH=/api/v1/files/reference
RWA_API_ISSUER_ANALYSIS_PATH=/api/v1/analysis/summary

# Téléchargements documentaires : deny-by-default dans la V1 publique.
RWA_REQUIRE_DOWNLOAD_ALLOWLIST=true
RWA_ALLOWED_DOWNLOAD_HOSTS=documents.example.com
RWA_MAX_DOWNLOAD_REDIRECTS=3
RWA_MAX_DOCX_ARCHIVE_MEMBERS=5000
RWA_MAX_DOCX_UNCOMPRESSED_BYTES=536870912
RWA_MAX_WHITEPAPER_BYTES=262144000
RWA_MAX_WHITEPAPER_PAGES=500
RWA_MAX_RENDER_PIXELS_PER_PAGE=50000000

# Timeouts (secondes)
RWA_LLM_REQUEST_TIMEOUT_SECONDS=180
RWA_PIPELINE_TIMEOUT_SECONDS=7200
RWA_DOCUMENT_PROCESS_TIMEOUT_SECONDS=300
RWA_PDF_RENDER_TIMEOUT_SECONDS=300
RWA_OCR_PAGE_TIMEOUT_SECONDS=120

# Les sorties LLM peuvent contenir le document client : désactivées par défaut.
RWA_ENABLE_RAW_LLM_LOGS=false
